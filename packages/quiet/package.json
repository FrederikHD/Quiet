{
  "name": "@frederikhd/quiet",
  "version": "1.1.0",
  "description": "Quiet design system — Vue 3 components, tokens and styles for commerce storefronts and back offices.",
  "license": "MIT",
  "author": "Frederik Gießke (https://github.com/FrederikHD)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrederikHD/Quiet.git",
    "directory": "packages/quiet"
  },
  "homepage": "https://frederikhd.github.io/Quiet/",
  "bugs": {
    "url": "https://github.com/FrederikHD/Quiet/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "components",
    "ui",
    "commerce",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/index.ts"
  ],
  "main": "./dist/quiet.js",
  "module": "./dist/quiet.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/quiet.js"
    },
    "./style.css": "./dist/quiet.css",
    "./tokens.json": "./src/tokens/tokens.json",
    "./tokens.css": "./src/styles/tokens.css",
    "./global": {
      "types": "./dist/types/global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/tokens/tokens.json",
    "src/styles/tokens.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && vite build && vue-tsc -p tsconfig.build.json && node scripts/copy-global-types.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

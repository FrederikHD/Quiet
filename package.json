{
  "name": "quiet-monorepo",
  "private": true,
  "description": "Quiet — a calm, neutral-first design system for commerce, in Vue.",
  "type": "module",
  "workspaces": [
    "packages/quiet",
    "packages/quiet-explorer",
    "packages/quiet-test"
  ],
  "scripts": {
    "dev": "npm run dev -w quiet-explorer",
    "build": "npm run build -w @frederikhd/quiet && npm run build -w quiet-explorer",
    "tokens": "npm run tokens -w @frederikhd/quiet",
    "typecheck": "npm run typecheck -w @frederikhd/quiet && npm run typecheck -w quiet-explorer && npm run typecheck -w quiet-test",
    "test": "npm run test -w quiet-test",
    "test:unit": "npm run test:unit -w quiet-test",
    "test:e2e": "npm run test:e2e -w quiet-test",
    "test:visual": "npm run test:visual -w quiet-test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:package": "npm run test:package -w quiet-test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=20"
  }
}
